---
// --- PROPS ---
const { displayedTitleName = "Putra & Elida" } = Astro.props;
import { Image } from 'astro:assets';
import BgOverlay from '../assets/images/bg-overlay-min.webp';
import bgMount from '../assets/images/bg-min.webp';
import ornFrame from '../assets/images/orn-frame-2-min.webp';
import orn33 from '../assets/images/orn-33-min.webp';
import orn1 from '../assets/images/orn-1-min.webp';
import orn5 from '../assets/images/orn-5-min.webp';
import orn2 from '../assets/images/orn-2-min.webp';
import orn40 from '../assets/images/orn-40-min.webp';
import orn37 from '../assets/images/orn-37-min.webp';
import orn36 from '../assets/images/orn-36-min.webp';
import orn28 from '../assets/images/orn-28-min.webp';
import orn3 from '../assets/images/orn-3-min.webp';
import orn8 from '../assets/images/orn-8-min.webp';

---
<section class="footnote-wrap" style="display: none;">
    <div class="footnote-inner">
        
        <div class="ornaments-wrapper">
            <div class="bg-footnote-forest">
                <div class="image-wrap" data-aos="zoom-out" data-aos-duration="1200" data-aos-delay="100"> 
                    <Image src={BgOverlay} alt="Ornament" format="webp" loading="eager" /> 
                </div>
            </div>
            <div class="bg-footnote-mount">
                <div class="image-wrap" data-aos="zoom-out" data-aos-duration="1200" data-aos-delay="200"> 
                    <Image src={bgMount} alt="Ornament" format="webp" loading="eager" /> 
                </div>
            </div>
        </div>
        
        <div class="orn-footnote-frame">
            <div class="image-wrap" data-aos="zoom-in" data-aos-duration="1200" data-aos-delay="100"> 
                <Image src={ornFrame} alt="Ornament" format="webp" loading="eager" /> 
            </div>
        </div>
        
        <div class="ornaments-wrapper">
            <div class="orn-footnote--bottom br-1">
                <div class="orn-footnote--bottom br-5">
                    <div class="image-wrap" data-aos="fade-up" data-aos-duration="1200" data-aos-delay="100"> <Image src={orn33} alt="Ornament" format="webp" loading="lazy" /> </div>
                </div>
                <div class="orn-footnote--bottom br-4">
                    <div class="image-wrap" data-aos="fade-up" data-aos-duration="1200" data-aos-delay="200"> <Image src={orn1} alt="Ornament" format="webp" loading="lazy" /> </div>
                </div>
                <div class="orn-footnote--bottom br-3">
                    <div class="image-wrap" data-aos="fade-up" data-aos-duration="1200" data-aos-delay="300"> <Image src={orn5} alt="Ornament" format="webp" loading="lazy" /> </div>
                </div>
                <div class="orn-footnote--bottom br-2">
                    <div class="image-wrap" data-aos="fade-up" data-aos-duration="1200" data-aos-delay="400"> <Image src={orn2} alt="Ornament" format="webp" loading="lazy" /> </div>
                </div>
                <div class="image-wrap" data-aos="fade-up" data-aos-duration="1200" data-aos-delay="500"> <Image src={orn40} alt="Ornament" format="webp" loading="lazy" /> </div>
                <div class="orn-footnote--bottom br-6">
                    <div class="image-wrap" data-aos="fade-up" data-aos-duration="1200" data-aos-delay="100"> <Image src={orn37} alt="Ornament" format="webp" loading="lazy" /> </div>
                </div>
                <div class="orn-footnote--bottom br-7">
                    <div class="image-wrap" data-aos="fade-up" data-aos-duration="1200" data-aos-delay="200"> <Image src={orn36} alt="Ornament" format="webp" loading="lazy" /> </div>
                </div>
                <div class="orn-footnote--bottom br-8">
                    <div class="image-wrap" data-aos="fade-up" data-aos-duration="1200" data-aos-delay="300"> <Image src={orn28} alt="Ornament" format="webp" loading="lazy" /> </div>
                </div>
                <div class="orn-footnote--bottom br-9">
                    <div class="image-wrap" data-aos="fade-up" data-aos-duration="1200" data-aos-delay="400"> <Image src={orn3} alt="Ornament" format="webp" loading="lazy" /> </div>
                </div>
                <div class="orn-footnote--bottom br-10">
                    <div class="image-wrap" data-aos="fade-up" data-aos-duration="1200" data-aos-delay="500"> <Image src={orn8} alt="Ornament" format="webp" loading="lazy" /> </div>
                </div>
            </div>
            
            <div class="orn-footnote--bottom bl-1">
                <div class="orn-footnote--bottom br-5">
                    <div class="image-wrap" data-aos="fade-up" data-aos-duration="1200" data-aos-delay="100"> <Image src={orn33} alt="Ornament" format="webp" loading="lazy" /> </div>
                </div>
                <div class="orn-footnote--bottom br-4">
                    <div class="image-wrap" data-aos="fade-up" data-aos-duration="1200" data-aos-delay="200"> <Image src={orn1} alt="Ornament" format="webp" loading="lazy" /> </div>
                </div>
                <div class="orn-footnote--bottom br-3">
                    <div class="image-wrap" data-aos="fade-up" data-aos-duration="1200" data-aos-delay="300"> <Image src={orn5} alt="Ornament" format="webp" loading="lazy" /> </div>
                </div>
                <div class="orn-footnote--bottom br-2">
                    <div class="image-wrap" data-aos="fade-up" data-aos-duration="1200" data-aos-delay="400"> <Image src={orn2} alt="Ornament" format="webp" loading="lazy" /> </div>
                </div>
                <div class="image-wrap" data-aos="fade-up" data-aos-duration="1200" data-aos-delay="500"> <Image src={orn40} alt="Ornament" format="webp" loading="lazy" /> </div>
                <div class="orn-footnote--bottom br-6">
                    <div class="image-wrap" data-aos="fade-up" data-aos-duration="1200" data-aos-delay="100"> <Image src={orn37} alt="Ornament" format="webp" loading="lazy" /> </div>
                </div>
                <div class="orn-footnote--bottom br-7">
                    <div class="image-wrap" data-aos="fade-up" data-aos-duration="1200" data-aos-delay="200"> <Image src={orn36} alt="Ornament" format="webp" loading="lazy" /> </div>
                </div>
                <div class="orn-footnote--bottom br-8">
                    <div class="image-wrap" data-aos="fade-up" data-aos-duration="1200" data-aos-delay="300"> <Image src={orn28} alt="Ornament" format="webp" loading="lazy" /> </div>
                </div>
                <div class="orn-footnote--bottom br-9">
                    <div class="image-wrap" data-aos="fade-up" data-aos-duration="1200" data-aos-delay="400"> <Image src={orn3} alt="Ornament" format="webp" loading="lazy" /> </div>
                </div>
                <div class="orn-footnote--bottom br-10">
                    <div class="image-wrap" data-aos="fade-up" data-aos-duration="1200" data-aos-delay="500"> <Image src={orn8} alt="Ornament" format="webp" loading="lazy" /> </div>
                </div>
            </div>
        </div> 
        
        <div class="footnote-details">
            <div class="footnote-details--content">
                <p class="bottom-text w-9/12" data-aos="fade-up" data-aos-duration="1200" data-aos-delay="1000">Merupakan suatu kebahagiaan dan kehormatan bagi kami, apabila Bapak/Ibu/Saudara/i, berkenan hadir dan memberikan do'a restu kepada kedua mempelai.</p>
                <p class="text-center">Hormat Kami Yang Mengundang</p>
                <h2 class="footnote-title" data-aos="fade-up" data-aos-duration="1200" data-aos-delay="800" class="computedFontStyle">{displayedTitleName}</h2>
            </div>
        </div>
    </div>
</section>
---
// --- PROPS ---
const { displayedTitleName, displayedGuestName } = Astro.props;
import { Image } from 'astro:assets';

import BgOverlay from '../assets/images/bg-overlay-min.webp';
import bgMount from '../assets/images/bg-min.webp';
import ornFrame2 from '../assets/images/orn-frame-2-min.webp';
import orn33 from '../assets/images/orn-33-min.webp';
import orn1 from '../assets/images/orn-1-min.webp';

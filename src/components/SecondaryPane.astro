                    <div class="orn-topcover--bottom br-9">
                        <div class="image-wrap" data-aos="fade-up" data-aos-duration="1200" data-aos-delay="400"> <Image src={orn3} alt="Ornament 3" format="webp" loading="lazy" /> </div>
                    </div>
                    <div class="orn-topcover--bottom br-10">
                        <div class="image-wrap" data-aos="fade-up" data-aos-duration="1200" data-aos-delay="500"> <Image src={orn8} alt="Ornament 8" format="webp" loading="lazy" /> </div>
                    </div>
                </div>
            </div> 
            <div class="top-cover-details--content" data-aos="fade-up" data-aos-duration="1200" data-aos-delay="1200">
                <h1 style="font-family: Hurricane, sans-serif">{displayedTitleName}</h1>
                <div class="link-wrap" data-aos="fade-up" data-aos-duration="1200" data-aos-delay="1200">
                    <p class="greeting-text">Kepada Yth. Bapak/Ibu/Saudara/i<br>&nbsp; <b style="font-weight: bold; font-size: 1.2em !important;">{displayedGuestName}</b></p> 
                    <a href="javascript:;" onclick="openInvitation()" class="link" id="startToExplore">Buka Undangan</a>
                </div>
            </div>
        </div>
    </section> 
    <section id="detailContent" class="cover-wrap" style="display: none;">
        <div class="ornaments-wrapper">
            <div class="bg-cover-forest">
                <div class="image-wrap" data-aos="zoom-out" data-aos-duration="1200" data-aos-delay="100"> <Image src={BgOverlay} alt="Ornament" format="webp" loading="eager" /> </div>
            </div>
            <div class="bg-cover-mount">
                <div class="image-wrap" data-aos="zoom-out" data-aos-duration="1200" data-aos-delay="200"> <Image src={bgMount} alt="Ornament" format="webp" loading="eager" /> </div>
            </div>
        </div>
        <div class="cover-inner">
            <div class="cover-illustration-head">
              <div data-aos="fade-down" data-aos-duration="1200" data-aos-delay="300" class="relative w-32 flex items-center justify-center mt-4 aos-init aos-animate monogram-wrapper">
                <center>
                </div> 
                <p style="text-align: center;">Undangan Pernikahan</p> 
                <h1 class="prime-title" style="font-family: Hurricane, sans-serif;">{displayedTitleName}</h1>
              </center>
            </div>
            <div class="cover-illustration-body">
                <div class="cover-details ">
                    <div class="cover-highlight have-desktop-cover have-mobile-cover">
                        <div class="cover-preview-wrap">
                            <div class="cover-preview cover-show" id="cover-main">
                                <div class="cover-picture mobile">
                                    <div class="cover-picture-image">
                                        <Image src={WulanLukman} alt="Lukman & Wulan Wedding Photo" style="width: 100%; height: auto; max-width: 400px; border-radius: 10px; box-shadow: 0 4px 15px rgba(0,0,0,0.2);" format="webp" loading="eager" /> 
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="ornaments-wrapper">
            <div class="orn-cover--bottom bl-6">
                <div class="image-wrap"> <Image src={orn31} alt="Ornament" format="webp" loading="lazy" /> </div>
                <div class="orn-cover--bottom bl-8 have-mobile-cover have-desktop-cover">
                    <div class="image-wrap"> <Image src={orn31} alt="Ornament" format="webp" loading="lazy" /> </div>
                </div>
            </div>
            <div class="orn-cover--bottom br-2">
                <div class="image-wrap"> <Image src={orn31} alt="Ornament" format="webp" loading="lazy" /> </div>

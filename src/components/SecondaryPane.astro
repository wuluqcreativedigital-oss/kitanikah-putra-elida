                    <div class="image-wrap"> <Image src={orn31} alt="Ornament" format="webp" loading="lazy" /> </div>
                </div>
            </div>
            <div class="orn-cover--bottom bc have-mobile-cover have-desktop-cover">
                <div class="image-wrap"> <Image src={orn34} alt="Ornament" format="webp" loading="lazy" /> </div>
            </div>
            <div class="orn-cover--bottom br-1">
                <div class="orn-cover--bottom bl-7">
                    <div class="image-wrap"> <Image src={orn1} alt="Ornament" format="webp" loading="lazy" /> </div>
                </div>
                <div class="orn-cover--bottom bl-5 ">
                    <div class="image-wrap"> <Image src={orn33} alt="Ornament" format="webp" loading="lazy" /> </div>
                </div>
                <div class="orn-cover--bottom bl-4">
                    <div class="image-wrap"> <Image src={orn21} alt="Ornament" format="webp" loading="lazy" /> </div>
                </div>
                <div class="orn-cover--bottom bl-3">
                    <div class="image-wrap"> <Image src={orn9} alt="Ornament" format="webp" loading="lazy" /> </div>
                </div>
                <div class="orn-cover--bottom bl-2">
                    <div class="image-wrap"> <Image src={orn27} alt="Ornament" format="webp" loading="lazy" /> </div>
                </div>
                <div class="image-wrap"> <Image src={orn20} alt="Ornament" format="webp" loading="lazy" /> </div>
            </div>
            <div class="orn-cover--bottom bl-1">
                <div class="orn-cover--bottom bl-7">
                    <div class="image-wrap"> <Image src={orn1} alt="Ornament" format="webp" loading="lazy" /> </div>

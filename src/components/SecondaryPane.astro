                    </div>
                    <div class="orn-topcover--bottom br-7">
                        <div class="image-wrap" data-aos="fade-up" data-aos-duration="1200" data-aos-delay="200"> <Image src={orn36} alt="Ornament 36" format="webp" loading="lazy" /> </div>

                    </div>
                    <div class="orn-topcover--bottom br-9">
                        <div class="image-wrap" data-aos="fade-up" data-aos-duration="1200" data-aos-delay="400"> <Image src={orn3} alt="Ornament 3" format="webp" loading="lazy" /> </div>
                    </div>
                    <div class="orn-topcover--bottom br-10">

<section class="secondary-pane">
    <section class="top-cover">
        <div class="top-cover-inner">
            <div class="ornaments-wrapper">
                <div class="bg-topcover-forest">
                    <div class="image-wrap" data-aos="zoom-out" data-aos-duration="1200" data-aos-delay="100"> 
                        <Image src={BgOverlay} alt="Background Overlay" format="webp" loading="eager" /> 
                    </div>
                </div>
                <div class="bg-topcover-mount">
                    <div class="image-wrap" data-aos="zoom-out" data-aos-duration="1200" data-aos-delay="200"> 
                        <Image src={bgMount} alt="Background Mountain" format="webp" loading="eager" /> 
                    </div>
                </div>
                <div class="orn-topcover-frame">
                    <div class="image-wrap" data-aos="zoom-in" data-aos-duration="1200" data-aos-delay="300"> 
                        <Image src={ornFrame2} alt="Ornament Frame 2" format="webp" loading="eager" /> 
                    </div>
                </div>
            </div>
            
            <div class="ornaments-wrapper">
                <div class="orn-topcover--bottom br-1">
                    <div class="orn-topcover--bottom br-5">
                        <div class="image-wrap" data-aos="fade-up" data-aos-duration="1200" data-aos-delay="100"> <Image src={orn33} alt="Ornament 33" format="webp" loading="lazy"} /> </div>
                    </div>

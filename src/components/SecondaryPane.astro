                        <div class="image-wrap" data-aos="fade-up" data-aos-duration="1200" data-aos-delay="400"> <Image src={orn2} alt="Ornament 2" format="webp" loading="lazy" /> </div>
                    </div>
                    <div class="image-wrap" data-aos="fade-up" data-aos-duration="1200" data-aos-delay="500"> <Image src={orn40} alt="Ornament 40" format="webp" loading="lazy" /> </div>
                    <div class="orn-topcover--bottom br-6">

---
import { Image } from 'astro:assets';
import orn18 from '../assets/images/orn-18-min.webp';
import orn2 from '../assets/images/orn-2-min.webp';
import orn16 from '../assets/images/orn-16-min.webp';
import orn4 from '../assets/images/orn-4-min.webp';
import orn3 from '../assets/images/orn-3-min.webp';
import orn7 from '../assets/images/orn-7-min.webp';
import orn30 from '../assets/images/orn-30-min.webp';
---
<section class="rsvp-wrap" style="display: none;">
    
    <div class="orn-rsvp--top tc-1">
        <div class="image-wrap" data-aos="fade-down" data-aos-duration="1200" data-aos-delay="100"> 
            <Image src={orn18} alt="Ornament" format="webp" /> 
        </div>
    </div>
    
    <div class="ornaments-wrapper">
        <div class="orn-rsvp--bottom bl-1">
            <div class="orn-rsvp--bottom bl-6">
                <div class="image-wrap" data-aos="fade-down" data-aos-duration="1200" data-aos-delay="100"> 
                    <Image src={orn2} alt="Ornament" format="webp" /> 
                </div>
            </div>
            <div class="orn-rsvp--bottom bl-5">
                <div class="image-wrap" data-aos="fade-down" data-aos-duration="1200" data-aos-delay="200"> 
                    <Image src={orn16} alt="Ornament" format="webp" /> 
                </div>
            </div>
            <div class="orn-rsvp--bottom bl-4">
                <div class="image-wrap" data-aos="fade-down" data-aos-duration="1200" data-aos-delay="300"> 
                    <Image src={orn4} alt="Ornament" format="webp" /> 
                </div>
            </div>
            <div class="orn-rsvp--bottom bl-3">
                <div class="image-wrap" data-aos="fade-down" data-aos-duration="1200" data-aos-delay="400"> 
                    <Image src={orn3} alt="Ornament" format="webp" /> 
                </div>
            </div>
            <div class="orn-rsvp--bottom bl-2">
                <div class="image-wrap" data-aos="fade-down" data-aos-duration="1200" data-aos-delay="500"> 
                    <Image src={orn7} alt="Ornament" format="webp" /> 
                </div>
            </div>
            <div class="image-wrap" data-aos="fade-down" data-aos-duration="1200" data-aos-delay="600"> 
                <Image src={orn30} alt="Ornament" format="webp" /> 
            </div>
        </div>
        
        <div class="orn-rsvp--bottom br-1">
            <div class="orn-rsvp--bottom bl-6">
                <div class="image-wrap" data-aos="fade-down" data-aos-duration="1200" data-aos-delay="100"> 
                    <Image src={orn2} alt="Ornament" format="webp" /> 
                </div>
            </div>
            <div class="orn-rsvp--bottom bl-5">
                <div class="image-wrap" data-aos="fade-down" data-aos-duration="1200" data-aos-delay="200"> 
                    <Image src={orn16} alt="Ornament" format="webp" /> 
                </div>
            </div>
            <div class="orn-rsvp--bottom bl-4">
                <div class="image-wrap" data-aos="fade-down" data-aos-duration="1200" data-aos-delay="300"> 
                    <Image src={orn4} alt="Ornament" format="webp" /> 
                </div>
            </div>
            <div class="orn-rsvp--bottom bl-3">
                <div class="image-wrap" data-aos="fade-down" data-aos-duration="1200" data-aos-delay="400"> 
                    <Image src={orn3} alt="Ornament" format="webp" /> 
                </div>
            </div>
            <div class="orn-rsvp--bottom bl-2">
                <div class="image-wrap" data-aos="fade-down" data-aos-duration="1200" data-aos-delay="500"> 
                    <Image src={orn7} alt="Ornament" format="webp" /> 
                </div>
            </div>
            <div class="image-wrap" data-aos="fade-down" data-aos-duration="1200" data-aos-delay="600"> 
                <Image src={orn30} alt="Ornament" format="webp" /> 
            </div>
        </div>
    </div>
    
    <div class="rsvp-inner">
        <div class="rsvp-head">
            <h6 class="rsvp-title" data-aos="zoom-in" data-aos-duration="1500">Reservasi Kehadiran</h6>
        </div>
        
        <form class="rsvp-form" onsubmit="submitRSVP(event)">
            <div class="form-group">
                <label for="nama" class="form-label">Nama Undangan</label>
                <input type="text" id="nama" name="nama" class="form-input" placeholder="Masukkan nama Anda" required>
            </div>
            
            <div class="form-group">
                <label for="jumlah" class="form-label">Jumlah Hadir</label>
                <select id="jumlah" name="jumlah" class="form-select" required>
                    <option value="">Pilih jumlah hadir</option>
                    <option value="1">1 Orang</option>
                    <option value="2">2 Orang</option>
                    <option value="3">3 Orang</option>
                </select>
            </div>
            
            <div class="form-group">
                <label for="ucapan" class="form-label">Ucapan & Doa</label>
                <textarea id="ucapan" name="ucapan" class="form-textarea" rows="4" placeholder="Tulis ucapan dan doa untuk kedua mempelai"></textarea>
            </div>
            
            <button type="submit" class="btn-submit">Kirim Reservasi</button>
        </form>
    </div>
</section>